# Dependencies
node_modules/

# Build output
dist/
dist.bak/

# n8n-node-cli local dev state
~/.n8n-node-cli/
.n8n-node-cli/
# Never use a --custom-user-folder path inside this repo — its symlink loops
# back on itself (ENAMETOOLONG). Always point --custom-user-folder outside
# the repo, e.g. ~/.n8n-docusign-dev.
.dev-n8n/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Env / secrets
.env
.env.*
!.env.example
secrets/

# OS
.DS_Store

# Editors
# .vscode/launch.json is tracked on purpose (n8n-node-cli scaffold's debug config)
.idea/
