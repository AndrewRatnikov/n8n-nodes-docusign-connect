# Copy this file to .env and fill in the values from the DocuSign Apps and
# Keys page (https://apps-d.docusign.com -> Apps and Keys) once you've done
# the manual steps in docs/plan.md Phase 1.
#
# .env is gitignored — never commit real values.

# "Integration Key" (a UUID) shown under General Info for your app.
DOCUSIGN_INTEGRATION_KEY=

# Your DocuSign User ID (a UUID, NOT your email) — shown at the top of the
# Apps and Keys page under your account name / My Account Information.
DOCUSIGN_USER_ID=

# Path to the RSA private key that pairs with the public key uploaded to
# DocuSign's "Service Integration" -> "Upload RSA" step.
# secrets/docusign-private.pem was generated locally and is gitignored.
DOCUSIGN_PRIVATE_KEY_PATH=./secrets/docusign-private.pem

# demo = account-d.docusign.com (sandbox), production = account.docusign.com
DOCUSIGN_ENV=demo
